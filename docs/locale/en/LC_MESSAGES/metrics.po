"print(f\"modified_nse = {float(result):.3f}\")"

msgid "modified_nse = 0.754"
msgstr "modified_nse = 0.754"

msgid "Единичный выброс в модельном ряду: сравните снижение каждой метрики относительно значения без выброса."
msgstr "A single outlier in the simulated series: compare the drop of each metric relative to its value without the outlier."

msgid ""
