msgid ""
"# Вероятность события получена из ансамбля из 20 членов\n"
"ens_rng = np.random.default_rng(7)\n"
"members = q_sim[:, None] + ens_rng.normal(0, 1, (q_obs.size, 20)) * (2 + 0.2 * q_sim[:, None])\n"
"threshold = np.quantile(q_obs, 0.9)\n"
"event_obs = (q_obs > threshold).astype(float)\n"
"prob_sim = (members > threshold).mean(axis=1)"
msgstr ""
"# Event probability derived from a 20-member ensemble\n"
"ens_rng = np.random.default_rng(7)\n"
"members = q_sim[:, None] + ens_rng.normal(0, 1, (q_obs.size, 20)) * (2 + 0.2 * q_sim[:, None])\n"
"threshold = np.quantile(q_obs, 0.9)\n"
"event_obs = (q_obs > threshold).astype(float)\n"
"prob_sim = (members > threshold).mean(axis=1)"

#, python-brace-format
msgid ""
"result = hm.brier_score(event_obs, prob_sim)\n"
"print(f\"brier_score = {float(result):.4f}\")"
msgstr ""
"result = hm.brier_score(event_obs, prob_sim)\n"
"print(f\"brier_score = {float(result):.4f}\")"

msgid "brier_score = 0.0080"
msgstr "brier_score = 0.0080"

#, python-brace-format
msgid "Опорный прогноз «климатическая частота» даёт :math:`\\bar{o}(1-\\bar{o})`. Индекса мастерства в библиотеке нет, он считается вручную:"
msgstr "The reference forecast climatological frequency gives :math:`\\bar{o}(1-\\bar{o})`. The library has no skill score, so it is computed by hand:"

msgid ""
"base_rate = event_obs.mean()\n"
"bs_climatology = base_rate * (1 - base_rate)\n"
"bs = float(hm.brier_score(event_obs, prob_sim))\n"
"print(round(bs, 5), round(bs_climatology, 5), round(1 - bs / bs_climatology, 3))"
msgstr ""
"base_rate = event_obs.mean()\n"
"bs_climatology = base_rate * (1 - base_rate)\n"
"bs = float(hm.brier_score(event_obs, prob_sim))\n"
"print(round(bs, 5), round(bs_climatology, 5), round(1 - bs / bs_climatology, 3))"

