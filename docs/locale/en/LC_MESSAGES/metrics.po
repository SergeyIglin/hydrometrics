"for (water_year,), value in by_year:\n"
"    print(int(water_year), round(float(value), 3))"
msgstr ""
"by_year = hm.compute_grouped(hm.mae, df, \"q_obs\", \"q_sim\", group_by=\"water_year\")\n"
"for (water_year,), value in by_year:\n"
"    print(int(water_year), round(float(value), 3))"

