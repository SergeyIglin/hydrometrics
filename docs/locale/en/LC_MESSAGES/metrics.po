"beta = q_sim.mean() / q_obs.mean()\n"
"gamma = (q_sim.std(ddof=1) / q_sim.mean()) / (q_obs.std(ddof=1) / q_obs.mean())\n"
"by_hand = 1 - np.sqrt((r - 1)**2 + (beta - 1)**2 + (gamma - 1)**2)\n"
