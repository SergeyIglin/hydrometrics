msgstr "nse_bounded = 0.912"

msgid "Метрика монотонно зависит от NSE, поэтому ранжирует модели так же; она лишь сжимает шкалу в :math:`(-1, 1]`."
msgstr "The metric depends monotonically on NSE, so it ranks models the same way; it only compresses the scale into :math:`(-1, 1]`."

