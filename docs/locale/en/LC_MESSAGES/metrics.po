msgid "Примеры"
msgstr "Examples"

msgid "Суточный гидрограф за три водных года с половодьем и меженью, расходы в м³/с."
msgstr "A daily hydrograph over three water years with a spring flood and low flow, discharge in m³/s."

msgid ""
"import numpy as np\n"
"import hydrometrics as hm\n"
"\n"
"rng = np.random.default_rng(42)\n"
"dates = np.arange(\"2010-10-01\", \"2013-10-01\", dtype=\"datetime64[D]\")\n"
"doy = (dates - dates.astype(\"datetime64[Y]\")).astype(int)\n"
"# Половодье в конце апреля поверх зимней и летней межени, м³/с\n"
"q_obs = 12 + 240 * np.exp(-(((doy - 118) / 16.0) ** 2)) + rng.gamma(2.0, 2.5, doy.size)\n"
"# Модель запаздывает на двое суток и срезает пик\n"
"q_sim = np.clip(0.88 * np.roll(q_obs, 2) + 3 + rng.normal(0, 5, doy.size), 0.1, None)"
msgstr ""
"import numpy as np\n"
"import hydrometrics as hm\n"
"\n"
"rng = np.random.default_rng(42)\n"
"dates = np.arange(\"2010-10-01\", \"2013-10-01\", dtype=\"datetime64[D]\")\n"
"doy = (dates - dates.astype(\"datetime64[Y]\")).astype(int)\n"
"# Spring flood in late April on top of winter and summer low flow, m³/s\n"
"q_obs = 12 + 240 * np.exp(-(((doy - 118) / 16.0) ** 2)) + rng.gamma(2.0, 2.5, doy.size)\n"
"# The model lags by two days and clips the peak\n"
"q_sim = np.clip(0.88 * np.roll(q_obs, 2) + 3 + rng.normal(0, 5, doy.size), 0.1, None)"

msgid ""
"# Событие: расход выше 90-го процентиля наблюдений\n"
"threshold = np.quantile(q_obs, 0.9)\n"
"event_obs = (q_obs > threshold).astype(float)\n"
"event_sim = (q_sim > threshold).astype(float)"
msgstr ""
"# Event: discharge above the 90th percentile of the observations\n"
"threshold = np.quantile(q_obs, 0.9)\n"
"event_obs = (q_obs > threshold).astype(float)\n"
"event_sim = (q_sim > threshold).astype(float)"

#, python-brace-format
msgid ""
"result = hm.accuracy(event_obs, event_sim)\n"
"print(f\"accuracy = {float(result):.4f}\")"
msgstr ""
"result = hm.accuracy(event_obs, event_sim)\n"
"print(f\"accuracy = {float(result):.4f}\")"

msgid "accuracy = 0.9881"
msgstr "accuracy = 0.9881"

msgid "Событие редкое (порог 90-го процентиля), поэтому прогноз «события не будет» никогда не пропускает дней без события и получает высокую долю верных:"
msgstr "The event is rare (a threshold at the 90th percentile), so a forecast that the event will never occur is never wrong on the days without the event and gets a high share of correct:"

msgid ""
"never = np.zeros_like(event_obs)\n"
"print(round(float(hm.accuracy(event_obs, event_sim)), 4), round(float(hm.accuracy(event_obs, never)), 4))"
msgstr ""
"never = np.zeros_like(event_obs)\n"
"print(round(float(hm.accuracy(event_obs, event_sim)), 4), round(float(hm.accuracy(event_obs, never)), 4))"

msgid "0.9881 0.8996"
msgstr "0.9881 0.8996"

msgid "По трём створам с разной редкостью события, ``axis=0``:"
msgstr "For three gauges with different event rarity, ``axis=0``:"

msgid ""
"# Три створа с разной редкостью события: пороги 80-й, 90-й и 95-й процентили\n"
"levels = [0.8, 0.9, 0.95]\n"
"event_obs_st = np.column_stack([q_obs > np.quantile(q_obs, k) for k in levels]).astype(float)\n"
"event_sim_st = np.column_stack([q_sim > np.quantile(q_obs, k) for k in levels]).astype(float)"
msgstr ""
"# Three gauges with different event rarity: thresholds at the 80th, 90th and 95th percentiles\n"
"levels = [0.8, 0.9, 0.95]\n"
"event_obs_st = np.column_stack([q_obs > np.quantile(q_obs, k) for k in levels]).astype(float)\n"
"event_sim_st = np.column_stack([q_sim > np.quantile(q_obs, k) for k in levels]).astype(float)"

msgid ""
"per_gauge = hm.accuracy(event_obs_st, event_sim_st, axis=0)\n"
"print(np.round(per_gauge.value, 4))"
msgstr ""
"per_gauge = hm.accuracy(event_obs_st, event_sim_st, axis=0)\n"
"print(np.round(per_gauge.value, 4))"

msgid "[0.8403 0.9881 0.9881]"
msgstr "[0.8403 0.9881 0.9881]"

msgid "По сезонам через :func:`~hydrometrics.compute_grouped`. В межень событий нет, поэтому метрики, которые делят на число событий или прогнозов, там не определены."
msgstr "By season with :func:`~hydrometrics.compute_grouped`. There are no events in low flow, so metrics that divide by the number of events or forecasts are undefined there."

msgid ""
"# Сезон по месяцу: половодье с апреля по июнь, остальные месяцы межень\n"
"month = dates.astype(\"datetime64[M]\").astype(int) % 12 + 1\n"
"season = np.where(np.isin(month, [4, 5, 6]), \"flood\", \"low_flow\")"
msgstr ""
"# Season by month: flood from April to June, low flow in the other months\n"
"month = dates.astype(\"datetime64[M]\").astype(int) % 12 + 1\n"
"season = np.where(np.isin(month, [4, 5, 6]), \"flood\", \"low_flow\")"

#, python-brace-format
msgid ""
"by_season = hm.compute_grouped(hm.accuracy, None, event_obs, event_sim, group_by={\"season\": season})\n"
"for (label,), value in by_season:\n"
"    print(label, round(float(value), 4))"
msgstr ""
"by_season = hm.compute_grouped(hm.accuracy, None, event_obs, event_sim, group_by={\"season\": season})\n"
"for (label,), value in by_season:\n"
"    print(label, round(float(value), 4))"

