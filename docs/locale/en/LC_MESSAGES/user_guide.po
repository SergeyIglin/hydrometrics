msgid "Порядок групп это порядок первого появления в данных, а не отсортированный. Группа без наблюдений в результат не попадает, так как состав групп определяется данными. Несколько группирующих переменных дают составные ключи:"
msgstr "The groups come in order of first appearance in the data, not sorted. A group without observations does not appear, since the groups are defined by the data. Several grouping variables give composite keys:"

msgid ""
"df[\"season\"] = np.where(df.index.month.isin([4, 5, 6]), \"flood\", \"low_flow\")\n"
"by_both = hm.compute_grouped(hm.kge_2012, df, \"q_obs\", \"q_sim\", group_by=[\"water_year\", \"season\"])\n"
"print(by_both.group_names)\n"
"print(by_both.to_pandas().round(3).to_string(index=False))"
msgstr ""
"df[\"season\"] = np.where(df.index.month.isin([4, 5, 6]), \"flood\", \"low_flow\")\n"
"by_both = hm.compute_grouped(hm.kge_2012, df, \"q_obs\", \"q_sim\", group_by=[\"water_year\", \"season\"])\n"
"print(by_both.group_names)\n"
"print(by_both.to_pandas().round(3).to_string(index=False))"

