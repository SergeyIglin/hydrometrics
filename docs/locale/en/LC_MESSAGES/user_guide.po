#, python-brace-format
msgid ""
"import pandas as pd\n"
"\n"
"df = pd.DataFrame({\"q_obs\": q_obs, \"q_sim\": q_sim}, index=pd.to_datetime(dates))\n"
"# Водный год начинается 1 октября и назван по году окончания\n"
"df[\"water_year\"] = df.index.year + (df.index.month >= 10)"
msgstr ""
"import pandas as pd\n"
"\n"
"df = pd.DataFrame({\"q_obs\": q_obs, \"q_sim\": q_sim}, index=pd.to_datetime(dates))\n"
"# The water year starts on 1 October and is named after its final year\n"
"df[\"water_year\"] = df.index.year + (df.index.month >= 10)"

msgid "Группы задаются столбцом таблицы или словарём массивов. Водный год начинается 1 октября."
msgstr "Groups are set by a table column or by a dictionary of arrays. The water year starts on 1 October."

msgid ""
"by_year = hm.compute_grouped(hm.nse, df, \"q_obs\", \"q_sim\", group_by=\"water_year\")\n"
"for (water_year,), value in by_year:\n"
"    print(int(water_year), round(float(value), 4))"
msgstr ""
"by_year = hm.compute_grouped(hm.nse, df, \"q_obs\", \"q_sim\", group_by=\"water_year\")\n"
"for (water_year,), value in by_year:\n"
"    print(int(water_year), round(float(value), 4))"

